NODE_ENV=production
PORT=3000
FRONTEND_ORIGIN=https://your-domain.com

JWT_SECRET=PASTE_LONG_RANDOM_CLIENT_SECRET_HERE
ADMIN_JWT_SECRET=PASTE_LONG_RANDOM_ADMIN_SECRET_HERE
COOKIE_NAME=wrbn_session
ADMIN_COOKIE_NAME=wrbn_admin_session

# Persistent server volume
DATABASE_PATH=/data/wrbn.sqlite
UPLOAD_DIR=/data/uploads
MAX_FILE_SIZE_MB=10

# External integrations — fill later
GOOGLE_SHEETS_WEBHOOK_URL=
PAYMENT_PROVIDER=dummy
PAYMENT_API_URL=
PAYMENT_API_KEY=

# First admin bootstrap
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_PASSWORD
ADMIN_RESET_PASSWORD=false
