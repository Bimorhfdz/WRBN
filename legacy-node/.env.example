NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:3000

# Session security
JWT_SECRET=CHANGE_ME_LONG_RANDOM_CLIENT_SECRET
ADMIN_JWT_SECRET=CHANGE_ME_LONG_RANDOM_ADMIN_SECRET
COOKIE_NAME=wrbn_session
ADMIN_COOKIE_NAME=wrbn_admin_session

# Database - SQLite file. In production, put this on a persistent server disk/volume.
DATABASE_PATH=./data/wrbn.sqlite

# Private uploads - also needs persistent disk/volume in production.
UPLOAD_DIR=./backend/uploads
MAX_FILE_SIZE_MB=10

# =============================
# OPTIONAL EXTERNAL API PLACEHOLDERS
# Paste real values here later. Never put secret API keys in public HTML/JS.
# =============================

# Google Sheets webhook (optional)
GOOGLE_SHEETS_WEBHOOK_URL=

# Payment gateway adapter (optional; dummy works locally)
PAYMENT_PROVIDER=dummy
PAYMENT_API_URL=
PAYMENT_API_KEY=

# Admin bootstrap account
# Run: npm run db:admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_RESET_PASSWORD=false
