APP_NAME=WRBN
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com
APP_LOCALE=id
APP_TIMEZONE=UTC

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=wrbn
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database

# --- WRBN ---
# Keamanan payment. Aplikasi MENOLAK start di production bila
# APP_KEY kosong, atau PAYMENT_PROVIDER=dummy tanpa ALLOW_DUMMY_PAY=true.
ALLOW_DUMMY_PAY=false
PAYMENT_PROVIDER=external
PAYMENT_API_URL=
PAYMENT_API_KEY=

# Integrasi opsional
GOOGLE_SHEETS_WEBHOOK_URL=
MAX_FILE_SIZE_MB=10

# CP general & bot
CP_GENERAL_NAME=
CP_GENERAL_WHATSAPP=
BOT_PROVIDER=link
BOT_API_URL=
BOT_API_KEY=

# Batas project aktif member
MEMBER_MAX_ACTIVE=3

# Bootstrap admin -> php artisan wrbn:create-admin
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=
ADMIN_RESET_PASSWORD=false
