# Local dependencies — Vercel runs `composer install --no-dev` during build.
/vendor

# Local state and secrets. Environment variables live in the Vercel dashboard.
.env
.env.*
!.env.example
/bootstrap/cache/*.php

# Keep the storage skeleton (its .gitignore placeholders) so the directory
# structure exists at runtime; only the runtime junk is left behind.
/storage/*
!/storage/**/.gitignore
/node_modules
/public/build

# Dumps are only used from a laptop. The CA certificate MUST be uploaded:
# MYSQL_ATTR_SSL_CA=certs/ca.pem points at it at runtime.
/backup
certs/*.key
/database/*.sqlite

# Development-only folders.
/.git
/.github
/.idea
/.vscode
/legacy-node
/tests
/phpunit.xml
/phpunit.xml.dist
